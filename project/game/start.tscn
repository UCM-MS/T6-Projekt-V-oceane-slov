[gd_scene format=3]

[ext_resource type="Script" path="res://start.gd" id="1"]
[ext_resource type="Texture2D" path="res://sprites/vos_logo.png" id="2"]
[ext_resource type="Texture2D" path="res://sprites/port6_logo.png" id="3"]

[node name="Start" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Branding" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="GameLogo" type="TextureRect" parent="Branding"]
texture_filter = 2
layout_mode = 1
anchor_left = 0.5
anchor_right = 0.5
offset_left = -238.0
offset_top = 48.0
offset_right = 238.0
offset_bottom = 258.0
mouse_filter = 2
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 5

[node name="TeamLogo" type="TextureRect" parent="Branding"]
texture_filter = 1
layout_mode = 1
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -114.0
offset_top = -114.0
offset_right = -18.0
offset_bottom = -18.0
mouse_filter = 2
texture = ExtResource("3")
expand_mode = 1
stretch_mode = 5

[node name="Menu" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -125.0
offset_top = 16.0
offset_right = 125.0
offset_bottom = 234.0
theme_override_constants/separation = 8

[node name="DiveButton" type="Button" parent="Menu"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
text = "Vstúpiť do vody"

[node name="LargeMapButton" type="Button" parent="Menu"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
text = "Veľká mapa (WIP)"

[node name="SettingsButton" type="Button" parent="Menu"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
text = "Nastavenia"

[node name="TileBoundaries" type="CheckButton" parent="Menu"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
tooltip_text = "Zobrazí začiatky a konce dielov vo Veľkej mape (WIP)."
text = "Hranice dielov mapy"

[node name="MenuHint" type="Label" parent="Menu"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Zmena platí do vypnutia hry."
horizontal_alignment = 1

[node name="Settings" type="PanelContainer" parent="."]
visible = false
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -140.0
offset_right = 200.0
offset_bottom = 140.0

[node name="Margin" type="MarginContainer" parent="Settings"]
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Settings/Margin"]
theme_override_constants/separation = 12
alignment = 1

[node name="Heading" type="Label" parent="Settings/Margin/Content"]
theme_override_font_sizes/font_size = 26
text = "Nastavenia"
horizontal_alignment = 1

[node name="Description" type="Label" parent="Settings/Margin/Content"]
text = "Vybrané slová po spoluhláskach"
horizontal_alignment = 1

[node name="Groups" type="GridContainer" parent="Settings/Margin/Content"]
unique_name_in_owner = true
size_flags_horizontal = 4
theme_override_constants/h_separation = 20
columns = 4

[node name="SelectionHint" type="Label" parent="Settings/Margin/Content"]
unique_name_in_owner = true
visible = false
text = "Vyber aspoň jednu spoluhlásku."
horizontal_alignment = 1

[node name="Done" type="Button" parent="Settings/Margin/Content"]
unique_name_in_owner = true
text = "Hotovo"

[connection signal="pressed" from="Menu/SettingsButton" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="Settings/Margin/Content/Done" to="." method="_on_done_pressed"]
[connection signal="pressed" from="Menu/DiveButton" to="." method="_on_dive_pressed" binds= ["res://water.tscn"]]
[connection signal="pressed" from="Menu/LargeMapButton" to="." method="_on_dive_pressed" binds= ["res://large_dive.tscn"]]
[connection signal="toggled" from="Menu/TileBoundaries" to="." method="_on_tile_boundaries_toggled"]
